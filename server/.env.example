PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/tender_intel

# Google Gemini (direct)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# low | high (Gemini 3.x thinking depth; low is enough for extraction)
GEMINI_THINKING_LEVEL=low

# OpenRouter (OpenAI-compatible gateway: DeepSeek, Claude, OpenAI, ...)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Bhushilp Tender Intelligence

# Default provider for segregation: gemini | openrouter
DEFAULT_PROVIDER=gemini

# Max input tokens we will send in one call (doc is windowed above this)
MAX_INPUT_TOKENS=800000
# Run the second "what did we miss?" pass per category
VERIFY_PASS=true

# Auto-fetch PDFs linked from inside uploaded PDFs and add them as context
# (one level deep only — links found inside a linked PDF are not followed)
FOLLOW_LINKS=true
MAX_LINKED_DOCS=8
MAX_LINKED_MB=60

# Per-call LLM request timeout (ms) — a last-resort ceiling for a truly dead
# connection, NOT a "fail fast" knob. Real successful calls on a large
# document have taken up to ~16 min; set well above that or you'll kill
# working requests (aborting also doesn't reliably cancel server-side, which
# can cause OpenRouter 402 "exceeds credits given in-flight requests" on
# subsequent calls). Default 20 min.
LLM_TIMEOUT_MS=1200000

# Cap on completion tokens per OpenRouter call (real usage tops out ~25-30k;
# leaving this unset lets OpenRouter reserve credit against the model's full
# output capacity, which can trip a 402 even on a healthy balance).
OPENROUTER_MAX_TOKENS=40000

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
JWT_SECRET=generate-with-node-crypto-randomBytes-48-hex
SESSION_DAYS=7
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Format: Name:email:password  (comma-separated for a second super admin)
SUPERADMINS=Admin One:admin1@example.com:a-strong-password
